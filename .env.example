# Copy to .env. All settings use the VECTURA_ prefix.
VECTURA_ENVIRONMENT=production
# SQLite (default, zero install) or free PostgreSQL installed natively:
# VECTURA_DATABASE_URL=postgresql+psycopg://vectura:CHANGE_ME@localhost:5432/vectura
VECTURA_AUTH_ENABLED=true
VECTURA_API_KEYS=["generate-a-long-random-key"]
VECTURA_CORS_ORIGINS=[]
VECTURA_ALLOW_RESET=false
# Free key: https://www.eia.gov/opendata/
VECTURA_EIA_API_KEY=
